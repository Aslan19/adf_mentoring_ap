							},
							"body": {
								"value": "{\n    \"DataFactoryName\": \"@{pipeline().DataFactory}\",\n    \"PipelineName\": \"@{pipeline().Pipeline}\",\n    \"RunId\": \"@{pipeline().RunId}\",\n    \"Status\": \"@{activity('Get logic app URL').Status}\",\n    \"ErrorMessage\": \"@{if(equals(activity('Get logic app URL').Status, 'Failed'), activity('Get logic app URL').error.message, 'Pipeline completed successfully.')}\"\n}",
								"type": "Expression"
							}
						}
					}
				],
				"policy": {
					"elapsedTimeMetric": {}
